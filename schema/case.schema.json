{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danielas2022/astra-prompt-lab/schema/case.schema.json",
  "title": "Astra Prompt Case",
  "description": "Schema for Astra (GPT-6) 3D generation prompt cases, documenting successes and failures",
  "type": "object",
  "required": ["id", "source", "prompt", "status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this case",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Brief descriptive title of the case",
      "minLength": 5,
      "maxLength": 200
    },
    "source": {
      "type": "string",
      "description": "Source of this prompt case",
      "enum": [
        "tripo",
        "beatapi",
        "x",
        "spider",
        "folk",
        "openai",
        "other"
      ]
    },
    "prompt": {
      "type": "string",
      "description": "The Astra prompt text",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Success or failure status",
      "enum": ["success", "fail", "partial", "unknown"]
    },
    "tags": {
      "type": "array",
      "description": "Categorization tags",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "category": {
      "type": "string",
      "description": "Primary category",
      "examples": ["character", "environment", "object", "abstract"]
    },
    "author": {
      "type": "string",
      "description": "Original author name or handle"
    },
    "authorLink": {
      "type": "string",
      "format": "uri",
      "description": "Link to author profile or source"
    },
    "upstreamUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL to original upstream content"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the original source (tweet, forum post, etc.)"
    },
    "imageUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL to generated image (if available)"
    },
    "modelUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL to generated 3D model (if available)"
    },
    "preview_url": {
      "type": "string",
      "format": "uri",
      "description": "Optional URL to the generated 3D model preview or result image"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or observations"
    },
    "failureReason": {
      "type": "string",
      "description": "Reason for failure (if status=fail or partial)"
    },
    "failure_reason": {
      "type": "string",
      "description": "Required for status=fail or status=partial: explanation of what went wrong",
      "minLength": 10
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Case creation timestamp"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this case was documented"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Case last updated timestamp"
    },
    "attribution": {
      "type": "object",
      "description": "Credit to the original creator of the prompt or case",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name or handle of the original creator",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "description": "Link to creator's profile or website",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "description": "License under which the prompt was shared (if specified)"
        }
      }
    },
    "model_version": {
      "type": "string",
      "description": "GPT/Astra model version used (e.g., 'gpt-6-astra', 'gpt-6.5-astra')"
    },
    "parameters": {
      "type": "object",
      "description": "Additional generation parameters used (if applicable)",
      "properties": {
        "style": {
          "type": "string"
        },
        "quality": {
          "type": "string",
          "enum": ["standard", "hd"]
        },
        "size": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional source-specific metadata",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["fail", "partial"]
          }
        }
      },
      "then": {
        "anyOf": [
          { "required": ["failureReason"] },
          { "required": ["failure_reason"] }
        ]
      }
    }
  ]
}
